---
import Layout from '../layouts/Layout.astro';
import ProfileSection from '../components/ProfileSection.astro';
import ContactLinks from '../components/ContactLinks.astro';
import FileDownload from '../components/FileDownload.astro';
import SkillsSection from '../components/SkillsSection.astro';
import AboutMe from '../components/AboutMe.astro';
import Experience from '../components/Experience.astro';
import Education from '../components/Education.astro';
---

<Layout title="About — Walid Birouk">
  <div class="flex flex-wrap py-6 gap-0">
    <div class="w-full md:w-1/3 px-4 mb-8 md:mb-0">
      <ProfileSection />
      <div class="mt-4"></div>
      <ContactLinks />
      <div class="mt-3"></div>
      <FileDownload fileLink="downloads/CV.pdf" fileLabel="CV.pdf" label="CV Download" />
      <div class="my-6 border-t border-subtle"></div>
      <SkillsSection />
    </div>
    <div class="w-full md:w-2/3 px-4">
      <AboutMe />
      <div class="my-8 border-t border-subtle"></div>
      <Experience />
      <div class="my-8 border-t border-subtle"></div>
      <Education />
    </div>
  </div>
</Layout>
