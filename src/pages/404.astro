---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="404 — Not Found">
  <div class="min-h-[60vh] flex flex-col items-center justify-center text-center">
    <h1 class="text-8xl font-mono font-bold text-accent mb-4">404</h1>
    <p class="text-muted text-xl mb-8">Page not found.</p>
    <a href={base} class="text-accent hover:underline font-mono">← Back home</a>
  </div>
</Layout>
