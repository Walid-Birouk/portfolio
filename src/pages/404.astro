---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Page not found | Walid Birouk">
  <div class="min-h-[50vh] pt-12">
    <h1 class="font-display font-bold text-[clamp(2.2rem,5vw,3.5rem)] text-fg">This page doesn't exist</h1>
    <p class="mt-3 text-fg2">The link may be old or mistyped.</p>
    <p class="mt-8"><a href={base} class="btn-primary">Go to the homepage</a></p>
  </div>
</Layout>
