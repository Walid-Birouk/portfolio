---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectFeatured from '../../components/ProjectFeatured.astro';
import ProjectRow from '../../components/ProjectRow.astro';

const projects = await getCollection('projects');
projects.sort((a, b) => a.data.order - b.data.order);
const [featured, ...rest] = projects;
---

<Layout
  title="Projects | Walid Birouk"
  description="Projects by Walid Birouk: data and AI work on a live online store, a RAG agent in HubSpot, railway anomaly detection, an Azure Databricks lakehouse, a Kafka streaming pipeline, a dbt warehouse and a data observability evaluation."
>
  <div class="pt-4">
    <h1 class="font-display font-bold text-[clamp(2.2rem,5vw,3.5rem)] leading-tight text-fg">Projects</h1>
    <p class="mt-3 text-fg2 max-w-[34rem]">AI and data systems I built for clients, employers and my own practice.</p>

    <div class="mt-10">
      <ProjectFeatured project={featured} />
    </div>

    <div class="mt-12 border-b border-subtle">
      {rest.map((project) => (
        <ProjectRow project={project} />
      ))}
    </div>
  </div>
</Layout>
