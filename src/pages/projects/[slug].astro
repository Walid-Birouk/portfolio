---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ImageCarousel from '../../components/ImageCarousel';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { slug: entry.data.pageSlug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, stack, images } = entry.data;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const imageUrls = images?.map((f: string) => `${base}/images/carousel/${f}`) ?? [];
---

<Layout title={`${title} — Walid Birouk`}>
  <div class="max-w-4xl mx-auto py-8">
    <h1 class="text-4xl font-mono text-center mb-3">{title}</h1>
    <p class="text-center text-muted mb-10">{stack}</p>

    {imageUrls.length > 0 && (
      <ImageCarousel images={imageUrls} client:load />
    )}

    <article class="prose-dark">
      <Content />
    </article>
  </div>
</Layout>
