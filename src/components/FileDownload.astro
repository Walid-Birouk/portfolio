---
interface Props {
  fileLink: string;
  fileLabel: string;
  label: string;
}

const { fileLink, fileLabel, label } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="text-center">
  <a
    href={`${base}/${fileLink}`}
    download={fileLabel}
    target="_blank"
    rel="noopener noreferrer"
    class="btn-quiet whitespace-nowrap"
  >
    {label}
  </a>
</div>
