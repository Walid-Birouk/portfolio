---
import { Image } from 'astro:assets';
import profilePic from '../images/profilePic.png';
---

<div class="flex flex-col items-center">
  <div class="w-2/3 max-w-xs mx-auto">
    <Image
      src={profilePic}
      alt="Walid Birouk"
      class="rounded-xl w-full"
      loading="eager"
    />
  </div>
  <h2 class="text-2xl font-display font-bold text-center mt-4">Walid Birouk</h2>
  <h3 class="text-base text-center text-accent mt-1">AI &amp; Data Engineer</h3>
  <p class="text-sm text-center text-muted mt-1">Paris, France</p>
</div>
