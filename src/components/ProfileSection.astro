---
import { Image } from 'astro:assets';
import profilePic from '../images/profilePic.png';
---

<div class="flex flex-col items-center">
  <div class="w-2/3 max-w-xs mx-auto">
    <Image
      src={profilePic}
      alt="Walid Birouk"
      class="rounded-lg w-full"
      loading="eager"
    />
  </div>
  <h2 class="text-2xl font-mono font-semibold text-center mt-4">Walid Birouk</h2>
  <h3 class="text-base text-center text-accent mt-1">Data Engineer · Master AI</h3>
</div>
