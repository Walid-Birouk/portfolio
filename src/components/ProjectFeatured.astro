---
import type { CollectionEntry } from 'astro:content';
import ProjectThumb from './ProjectThumb.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, stack, pageSlug, flow, description, liveUrl } = project.data;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/projects/${pageSlug}`;

// The architecture diagram on the project page doubles as the card image,
// so there is one copy to keep accurate.
const diagram = project.body.match(/<svg[\s\S]*?<\/svg>/)?.[0];
---

<a
  href={href}
  class="group block bg-surface border border-subtle rounded-xl overflow-hidden transition-colors hover:border-accent/60"
>
  {diagram ? (
    <div class="p-5 sm:p-8 border-b border-subtle bg-bg overflow-x-auto" set:html={diagram} />
  ) : (
    <ProjectThumb flow={flow} label={title} class="h-56 border-b border-subtle" />
  )}
  <div class="p-6 md:p-8 grid md:grid-cols-[1.4fr_1fr] gap-x-10 gap-y-4">
    <div>
      {liveUrl && (
        <p class="text-sm text-fg2 flex items-center gap-2 mb-3">
          <span class="w-2 h-2 rounded-full bg-signal" aria-hidden="true"></span>
          Live client store
        </p>
      )}
      <h2 class="font-display font-bold text-3xl text-fg group-hover:text-accent transition-colors">{title}</h2>
      <p class="mt-3 text-fg2 text-[0.98rem]">{description}</p>
    </div>
    <p class="text-sm text-muted md:self-end">{stack.split(' & ').join(', ')}</p>
  </div>
</a>
