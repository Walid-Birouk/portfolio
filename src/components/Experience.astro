---
import { Image } from 'astro:assets';
import { ShoppingBagIcon, CpuChipIcon } from '@heroicons/react/24/solid';
import algorhythmLogo from '../images/logo/algorhythm.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div>
  <h2 class="font-display font-bold text-2xl text-fg mb-8">Work experience</h2>

  <!-- Ghazeline -->
  <div class="mb-10">
    <div class="flex items-center mb-2 gap-3">
      <div class="w-8 h-8 flex-shrink-0 flex items-center justify-center">
        <ShoppingBagIcon className="w-7 h-7 text-accent" />
      </div>
      <h2 class="text-xl font-display font-bold">Data Engineer, Ghazeline</h2>
    </div>
    <p class="text-accent text-sm">January 2026 – present</p>
    <p class="text-accent text-sm mb-2">Freelance, ghazeline.com</p>
    <p class="text-muted text-sm mb-3">
      Online store of a ready-to-wear fashion brand.
    </p>
    <ul class="teal-bullets space-y-1 text-fg2 text-sm mb-3">
      <li>Designed the PostgreSQL / Supabase data model: products, variants, categories, stock and orders.</li>
      <li>Built backend features for data collection that feed the data model.</li>
      <li>Automated the creation of order summary sheets.</li>
      <li>Deployed an AI agent on n8n that automates replies on Instagram.</li>
      <li>Maintain the store: fixes and new features from business feedback, and monitoring of the data flows.</li>
    </ul>
    <p class="text-muted text-xs font-display mb-2">
      <span class="text-fg2">Stack:</span> PostgreSQL, Supabase, n8n
    </p>
    <a href={`${base}/projects/ghazeline-shop`} class="text-accent text-sm font-display hover:underline">
      Read the write-up
    </a>
  </div>

  <!-- RideOnTrack -->
  <div class="mb-10">
    <div class="flex items-center mb-2 gap-3">
      <div class="w-8 h-8 flex-shrink-0 flex items-center justify-center">
        <CpuChipIcon className="w-7 h-7 text-accent" />
      </div>
      <h2 class="text-xl font-display font-bold">ML Engineer, RideOnTrack (Infrabel project)</h2>
    </div>
    <p class="text-accent text-sm mb-3">January 2025 – August 2025</p>
    <ul class="teal-bullets space-y-1 text-fg2 text-sm mb-3">
      <li>Developed an anomaly detection system for Belgian railway tracks using machine learning and computer vision.</li>
      <li>Implemented a U-Net segmentation model and an autoencoder to isolate critical areas and improve detection.</li>
      <li>Integrated YOLOv8 for real-time train signal recognition, reaching 91% accuracy.</li>
    </ul>
    <p class="text-muted text-xs font-display">
      <span class="text-fg2">Stack:</span> Python, TensorFlow, U-Net, YOLOv8, AWS SageMaker, Git
    </p>
  </div>

  <!-- Algorhythm: GenAI -->
  <div class="mb-10">
    <div class="flex items-center mb-2 gap-3">
      <Image src={algorhythmLogo} alt="Algorhythm" width={32} height={32} class="w-8 h-8 flex-shrink-0" />
      <h2 class="text-xl font-display font-bold">Generative AI Engineer, Algorhythm</h2>
    </div>
    <p class="text-accent text-sm mb-3">September 2024 – December 2024</p>
    <ul class="teal-bullets space-y-1 text-fg2 text-sm mb-3">
      <li>Developed AI workflows on Vertex AI and BigQuery to automate internal tasks with a consistent, specialised tone.</li>
      <li>Built a RAG agent that retrieves internal BigQuery data for accurate, context-aware answers.</li>
      <li>Integrated the agent into HubSpot to support internal communication and automate repetitive queries.</li>
    </ul>
    <p class="text-muted text-xs font-display">
      <span class="text-fg2">Stack:</span> Vertex AI, BigQuery, HubSpot
    </p>
  </div>

  <!-- Algorhythm: internship -->
  <div class="mb-4">
    <div class="flex items-center mb-2 gap-3">
      <Image src={algorhythmLogo} alt="Algorhythm" width={32} height={32} class="w-8 h-8 flex-shrink-0" />
      <h2 class="text-xl font-display font-bold">Data Engineering &amp; Data Quality Intern, Algorhythm</h2>
    </div>
    <p class="text-accent text-sm">February 2024 – July 2024</p>
    <p class="text-accent text-sm mb-2">Turnhout, Belgium</p>
    <p class="text-muted text-sm mb-3">Specialized consultancy in Modern Data Stack and AI solutions.</p>
    <ul class="teal-bullets space-y-1 text-fg2 text-sm mb-3">
      <li>Built a data observability proof of concept: automated dbt tests and manual data-quality checks, with results piped to OpenMetadata.</li>
    </ul>
    <p class="text-muted text-xs font-display mb-2">
      <span class="text-fg2">Stack:</span> dbt, OpenMetadata
    </p>
    <a href={`${base}/projects/data-observability-internship`} class="text-accent text-sm font-display hover:underline">
      Read the write-up
    </a>
  </div>
</div>
